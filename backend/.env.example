# Portainer
PORTAINER_URL=https://portainer.example.com
PORTAINER_TOKEN=

# Proxmox VE API token (primary/first cluster).
PROXMOX_URL=https://proxmox.example.com:8006
PROXMOX_TOKEN_ID=user@pam!tokenid
PROXMOX_TOKEN_SECRET=
# Optional: friendly name for this cluster, shown in the UI once more than
# one cluster is configured. Defaults to "Primary".
# PROXMOX_NAME=Home Cluster

# Optional: additional Proxmox clusters beyond the primary one above, merged
# into the same dashboard. JSON array; each entry needs name/url/tokenId/
# tokenSecret. Cluster names must be unique (they become the id used in
# URLs, e.g. "Office Cluster" -> /proxmox/nodes/office-cluster/...).
# PROXMOX_CLUSTERS=[{"name":"Office Cluster","url":"https://proxmox2.example.com:8006","tokenId":"user@pam!tokenid","tokenSecret":"..."}]

# Camera relay.
#
# Point this at go2rtc, not at the camera. FFmpeg has no out-of-band auth for
# RTSP, so a camera URL here would put the password in the process command
# line, readable by any process on the host. go2rtc keeps the credential in
# its own config and republishes a credential-free stream. See compose/camera.
TAPO_C100_RTSP_URL=rtsp://127.0.0.1:8554/tapo-c100

# Optional: path to the ffmpeg binary if it is not on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# What's Up Docker — feeds the Updates page with per-container version/update
# status. Watchtower itself has no API; WUD is the read side, Watchtower does
# the scheduled check (monitor-only, no auto-apply).
WUD_URL=http://wud.example.com:3009
