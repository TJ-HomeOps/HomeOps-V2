# Portainer
PORTAINER_URL=https://portainer.example.com
PORTAINER_TOKEN=

# Proxmox VE API token
PROXMOX_URL=https://proxmox.example.com:8006
PROXMOX_TOKEN_ID=user@pam!tokenid
PROXMOX_TOKEN_SECRET=

# Camera relay.
#
# Point this at go2rtc, not at the camera. FFmpeg has no out-of-band auth for
# RTSP, so a camera URL here would put the password in the process command
# line, readable by any process on the host. go2rtc keeps the credential in
# its own config and republishes a credential-free stream. See compose/camera.
TAPO_C100_RTSP_URL=rtsp://127.0.0.1:8554/tapo-c100

# Optional: path to the ffmpeg binary if it is not on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
